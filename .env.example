# Copy to .env (gitignored) on the server and set strong values.
# docker compose reads this file; each backend's DATABASE_URL / RABBITMQ_URL must use the same passwords.
# Postgres only applies these on first start (empty volume) — changing them later needs ALTER USER.
VENDOR_DB_PASSWORD=
PROCUREMENT_DB_PASSWORD=
INVENTORY_DB_PASSWORD=
RECEIVING_DB_PASSWORD=
WAREHOUSE_DB_PASSWORD=
POS_DB_PASSWORD=
AUDIT_DB_PASSWORD=
FINANCIALS_DB_PASSWORD=
RABBITMQ_PASSWORD=
