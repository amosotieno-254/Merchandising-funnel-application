# Reverse proxy for the production stack (docker-compose.prod.yml).
#
#   /<app>/        -> <app>-web   (vite preview, built with base /<app>/)
#   /<app>/api/    -> <app>-api   (prefix stripped: /<app>/api/v1/x -> /api/v1/x)
#
# Template: the nginx image renders this to /etc/nginx/conf.d/default.conf,
# substituting ${DOMAIN} only (NGINX_ENVSUBST_FILTER in docker-compose.prod.yml).
#
# TLS: Let's Encrypt cert for ${DOMAIN} issued by certbot (DNS-01 via
# Cloudflare) into ./certbot/conf, mounted at /etc/letsencrypt. Cloudflare
# (SSL mode "Full (strict)") connects to :443. Port 80 only redirects to HTTPS.
#
# Upstreams are resolved per request through Docker's DNS, so nginx starts
# (and keeps serving the other apps) even if one container is down.

resolver 127.0.0.11 valid=10s ipv6=off;

server {
  listen 80;
  server_name _;

  location = /healthz {
    access_log off;
    return 200 "ok\n";
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_session_cache   shared:SSL:10m;
  ssl_session_timeout 1d;

  client_max_body_size 10m;
  absolute_redirect off;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  location = / {
    root /usr/share/nginx/html;
    try_files /index.html =404;
  }

  location = /healthz {
    access_log off;
    return 200 "ok\n";
  }

  # ---------------------------------------------------------------- vendor

  location = /vendor { return 301 /vendor/; }

  location /vendor/api/ {
    set $upstream vendor-api:3001;
    rewrite ^/vendor(/api/.*)$ $1 break;
    proxy_pass http://$upstream;
  }

  location /vendor/ {
    set $upstream vendor-web:4173;
    proxy_pass http://$upstream;
  }

  # ---------------------------------------------------------------- procurement

  location = /procurement { return 301 /procurement/; }

  location /procurement/api/ {
    set $upstream procurement-api:3002;
    rewrite ^/procurement(/api/.*)$ $1 break;
    proxy_pass http://$upstream;
  }

  # Supplier lookups from the procurement UI go straight to the vendor API.
  location /procurement/vendor-api/ {
    set $upstream vendor-api:3001;
    rewrite ^/procurement/vendor-api(/.*)$ /api$1 break;
    proxy_pass http://$upstream;
  }

  location /procurement/ {
    set $upstream procurement-web:4173;
    proxy_pass http://$upstream;
  }

  # ---------------------------------------------------------------- inventory

  location = /inventory { return 301 /inventory/; }

  location /inventory/api/ {
    set $upstream inventory-api:3003;
    rewrite ^/inventory(/api/.*)$ $1 break;
    proxy_pass http://$upstream;
  }

  location /inventory/ {
    set $upstream inventory-web:4173;
    proxy_pass http://$upstream;
  }

  # ---------------------------------------------------------------- receiving

  location = /receiving { return 301 /receiving/; }

  location /receiving/api/ {
    set $upstream receiving-api:3004;
    rewrite ^/receiving(/api/.*)$ $1 break;
    proxy_pass http://$upstream;
  }

  location /receiving/ {
    set $upstream receiving-web:4173;
    proxy_pass http://$upstream;
  }

  # ---------------------------------------------------------------- warehouse

  location = /warehouse { return 301 /warehouse/; }

  location /warehouse/api/ {
    set $upstream warehouse-api:3005;
    rewrite ^/warehouse(/api/.*)$ $1 break;
    proxy_pass http://$upstream;
  }

  location /warehouse/ {
    set $upstream warehouse-web:4173;
    proxy_pass http://$upstream;
  }
}
