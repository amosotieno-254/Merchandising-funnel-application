{
  "name": "mms-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/vendor-management/backend",
    "packages/procurement/backend",
    "packages/inventory/backend",
    "packages/receiving/backend",
    "packages/warehouse-operations/backend",
    "packages/retail-sales/backend",
    "packages/sales-audit/backend" ,
    "packages/financials/backend"


  ],
  "scripts": {
    "dev:vendor": "npm --workspace @mms/vendor-backend run dev",
    "dev:procurement": "npm --workspace @mms/procurement-backend run dev",
    "dev:inventory": "npm --workspace @mms/inventory-backend run dev",
    "dev:receiving": "npm --workspace @mms/receiving-backend run dev",
    "dev:warehouse": "npm --workspace @mms/warehouse-operations-backend run dev",
    "dev:pos": "npm --workspace @mms/retail-sales-backend run dev",
    "dev:audit": "npm --workspace @mms/sales-audit-backend run dev" ,
    "dev:financials": "npm --workspace @mms/financials-backend run dev",


    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2"
  }
}